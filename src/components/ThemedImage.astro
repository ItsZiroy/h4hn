---
import {
  Image,
  type LocalImageProps,
  type RemoteImageProps,
} from "astro:assets";
import { cn } from "../lib/utils";
import type File from "../interfaces/file";

type SizeMap = Record<
  string,
  "tiny" | "xs" | "small" | "medium" | "large" | "xl"
>;

type Props = {
  alt: string;
  image: File;
  imageDark?: File;
  size?: "tiny" | "xs" | "small" | "medium" | "large" | "xl";
  sizeMap?: SizeMap;
  inferSize?: true;
  widths?: number[];
} & Partial<
  Omit<LocalImageProps | RemoteImageProps, "inferSize" | "widths" | "densities">
>;

const {
  alt,
  image,
  imageDark,
  size,
  sizeMap,
  width,
  height,
  inferSize: _inferSize,
  widths: _widths,
  class: className,
  ...rest
} = Astro.props;
const STRAPI_URL = import.meta.env.STRAPI_URL;

function getWidths(
  img: File | undefined,
  map: SizeMap
) {
  if (!img?.formats) return undefined;

  return Object.entries(map)
    .filter(([width, key]) => /^\d+w$/.test(width) && img.formats[key])
    .map(([width]) => Number.parseInt(width, 10))
    .sort((a, b) => a - b);
}

const srcLogo = size
  ? STRAPI_URL + image.formats[size].url
  : STRAPI_URL + image.url;
const srcLogoDark = size
  ? STRAPI_URL + imageDark?.formats[size].url
  : STRAPI_URL + imageDark?.url;

const responsiveLogoProps = sizeMap
  ? { widths: getWidths(image, sizeMap) }
  : {};
const responsiveLogoDarkProps = sizeMap
  ? { widths: getWidths(imageDark, sizeMap) }
  : {};
---

<Image
  src={sizeMap ? STRAPI_URL + image.url : srcLogo}
  alt={alt}
  width={width ?? image.width}
  height={height ?? image.height}
  class={cn(className, imageDark && "hidden dark:block")}
  title={alt}
  {...responsiveLogoProps}
  {...rest}
/>
{
  imageDark && (
    <Image
      src={sizeMap ? STRAPI_URL + imageDark.url : srcLogoDark}
      alt={alt}
      width={width ?? imageDark.width}
      height={height ?? imageDark.height}
      class={cn(className, "dark:hidden")}
      title={alt}
      {...responsiveLogoDarkProps}
      {...rest}
    />
  )
}
